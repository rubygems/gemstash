#!/usr/bin/env bash
# Launch, inspect, drive, and tear down a disposable Gemstash server built from
# this checkout. Run `verify-gemstash help` for usage.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="$(cd "$SKILL_DIR/../../.." && pwd)"
RUN_ROOT="${VERIFY_GEMSTASH_ROOT:-${TMPDIR:-/tmp}/verify-gemstash}"
# Resolve symlinks (macOS TMPDIR lives under /var -> /private/var) so paths
# match what lsof and ps report for the server.
RUN_ROOT="$(mkdir -p "$RUN_ROOT" && cd -P "$RUN_ROOT" && pwd)"
EVIDENCE_ROOT="${VERIFY_GEMSTASH_EVIDENCE:-$REPO/tmp/verify-gemstash}"

usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [args]

  launch [--protected-fetch] [--upstream URL] [--set KEY=VALUE]...
        Start a fresh server on a free 127.0.0.1 port with its own base_path.
        --set adds a config key, such as db_adapter=postgres or
        cache_type=redis. Prints RUN=<id>, URL, and the evidence directory.
  doctor RUN       Read-only check that RUN is ours, alive, healthy, and still
        running the code in this checkout.
  run RUN LABEL 'SHELL COMMAND'
        Run a shell command as a Gemstash user: cwd is the run's work dir,
        HOME is isolated, \`gemstash\` is this checkout,
        \$VERIFY_GEMSTASH_URL is the server, and \$VERIFY_GEMSTASH_LOG is its
        server.log. Records command, stdout, stderr, and exit code as
        evidence. Exits with the command's status.
  make-gem RUN NAME VERSION
        Build NAME-VERSION.gem in the run's work dir (a minimal test gem).
  state RUN LABEL  Record stored state: database rows and base_path files.
  cleanup RUN      Stop the server and delete scratch state; keep evidence.
  list             Show runs under $RUN_ROOT.
  help             Show this text.

LABEL names the evidence files; use letters, digits, ".", "_", and "-".
Runs live in $RUN_ROOT/<RUN>; evidence in $EVIDENCE_ROOT/<RUN>.
EOF
}

die() { echo "verify-gemstash: $*" >&2; exit 1; }

load_run() {
  [ -n "${1:-}" ] || die "missing RUN id"
  RUN="$1"
  RUN_DIR="$RUN_ROOT/$RUN"
  [ -f "$RUN_DIR/instance.env" ] || die "no run at $RUN_DIR (already cleaned up?); \`list\` shows the runs on disk"
  # shellcheck disable=SC1091
  . "$RUN_DIR/instance.env"
}

alive() { kill -0 "$1" 2>/dev/null; }

proc_cwd() { (lsof -a -p "$1" -d cwd -Fn 2>/dev/null || true) | sed -n 's/^n//p'; }

# CRuby puma retitles itself "puma <version> (<bind>) [<cwd basename>]"; on
# JRuby the JVM keeps its java command line, which ends in our start command.
server_cmdline() {
  case "$1" in
    "puma "*"(tcp://127.0.0.1:$PORT)"*|*"bin/gemstash start --config-file $RUN_DIR/config.yml") return 0 ;;
    *) return 1 ;;
  esac
}

# True only while PID is this run's server, so a reused PID is never signaled.
is_our_server() {
  alive "$1" && server_cmdline "$(ps -o args= -p "$1" 2>/dev/null || true)" \
    && [ "$(proc_cwd "$1")" = "$RUN_DIR/work" ]
}

check_label() {
  [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]] || die "LABEL '${1:-}' must use only letters, digits, '.', '_', and '-'"
}

# Hash of the code a server loads at start, so doctor can tell when the
# checkout has changed under a running server.
code_fingerprint() { # RUBY_BIN
  (cd "$REPO" && "$1/ruby" -rdigest -e '
    files = Dir["{lib,bin,exe}/**/*", "Gemfile", "Gemfile.lock", "gemstash.gemspec"].select { |f| File.file?(f) }.sort
    print Digest::SHA256.hexdigest(files.map { |f| f + Digest::SHA256.file(f).hexdigest }.join)')
}

# Build the PATH and environment a user of this checkout would have.
user_env() {
  env -i \
    PATH="$RUN_DIR/bin:$RUBY_BIN:/usr/local/bin:/usr/bin:/bin" \
    HOME="$RUN_DIR/home" \
    TERM="${TERM:-dumb}" LANG="${LANG:-C.UTF-8}" \
    GEMSTASH_CONFIG="$RUN_DIR/config.yml" \
    VERIFY_GEMSTASH_URL="$URL" \
    VERIFY_GEMSTASH_LOG="$RUN_DIR/base/server.log" \
    VERIFY_GEMSTASH_RUN="$RUN" \
    "$@"
}

next_seq() {
  local n
  n=$(find "$EVIDENCE" -maxdepth 1 -name '[0-9]*-*.cmd' | wc -l)
  printf '%02d' $((n + 1))
}

record() { # LABEL COMMAND
  local label="$1" cmd="$2" seq base status
  seq=$(next_seq)
  base="$EVIDENCE/$seq-$label"
  printf '%s\n' "$cmd" > "$base.cmd"
  set +e
  (cd "$RUN_DIR/work" && user_env bash -c "$cmd") > "$base.out" 2> "$base.err"
  status=$?
  set -e
  echo "$status" > "$base.exit"
  {
    printf '\n## %s %s\n\n$ %s\nexit: %s\n' "$seq" "$label" "$cmd" "$status"
    printf -- '--- stdout\n'; cat "$base.out"
    printf -- '--- stderr\n'; cat "$base.err"
  } >> "$EVIDENCE/transcript.md"
  echo "\$ $cmd"; cat "$base.out"; cat "$base.err" >&2
  echo "[exit $status] evidence: $base.{cmd,out,err,exit}"
  return "$status"
}

cmd_launch() {
  local protected=false upstream="https://rubygems.org" settings=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --protected-fetch) protected=true ;;
      --upstream) upstream="$2"; shift ;;
      --set)
        [[ "${2:-}" =~ ^[a-z_]+=[^[:space:]]+$ ]] || die "--set takes KEY=VALUE, such as db_adapter=postgres"
        # The helper owns these: they keep each run disposable and under its control.
        case "${2%%=*}" in
          base_path|bind|pidfile|log_file|rubygems_url|protected_fetch)
            die "--set cannot change ${2%%=*}; use --upstream or --protected-fetch for those two, the rest are owned by the run" ;;
        esac
        settings="$settings $2"; shift ;;
      *) die "unknown launch option: $1" ;;
    esac
    shift
  done
  [[ "$upstream" =~ ^https?://[^[:space:]]+$ ]] || die "--upstream takes an http(s) URL, such as https://rubygems.org"

  local ruby_bin
  ruby_bin=$(cd "$REPO" && { mise exec -- ruby -e 'print RbConfig::CONFIG["bindir"]' 2>/dev/null \
    || ruby -e 'print RbConfig::CONFIG["bindir"]'; }) || die "no Ruby found; run .agents/setup or bin/setup"
  BUNDLE_GEMFILE="$REPO/Gemfile" "$ruby_bin/bundle" check > /dev/null \
    || die "bundle is incomplete; run bin/setup (or .agents/setup) first"

  RUN="$(date +%Y%m%d-%H%M%S)-$$"
  RUN_DIR="$RUN_ROOT/$RUN"
  EVIDENCE="$EVIDENCE_ROOT/$RUN"
  mkdir -p "$RUN_DIR"/{base,home,work,bin} "$EVIDENCE"

  local code
  code=$(code_fingerprint "$ruby_bin")
  PORT=$("$ruby_bin/ruby" -rsocket -e 's = TCPServer.new("127.0.0.1", 0); print s.addr[1]; s.close')
  URL="http://127.0.0.1:$PORT"
  cat > "$RUN_DIR/config.yml" <<EOF
---
:base_path: $RUN_DIR/base
:bind: tcp://127.0.0.1:$PORT
:rubygems_url: $upstream
:protected_fetch: $protected
EOF
  local kv
  for kv in $settings; do printf ':%s: %s\n' "${kv%%=*}" "${kv#*=}" >> "$RUN_DIR/config.yml"; done

  # `gemstash` on the user PATH runs this checkout with its own bundle.
  cat > "$RUN_DIR/bin/gemstash" <<EOF
#!/usr/bin/env bash
exec env -u BUNDLE_PATH -u BUNDLE_APP_CONFIG BUNDLE_GEMFILE="$REPO/Gemfile" "$ruby_bin/ruby" "$REPO/bin/gemstash" "\$@"
EOF
  chmod +x "$RUN_DIR/bin/gemstash"

  # The server runs in the foreground of its own process; we own this PID.
  (cd "$RUN_DIR/work" && exec env BUNDLE_GEMFILE="$REPO/Gemfile" \
    "$ruby_bin/ruby" "$REPO/bin/gemstash" start --config-file "$RUN_DIR/config.yml") \
    > "$RUN_DIR/launch.log" 2>&1 < /dev/null &
  local pid=$!

  # instance.env is sourced later, so every value is shell-quoted with %q.
  PID=$pid RUBY_BIN=$ruby_bin PROTECTED_FETCH=$protected UPSTREAM=$upstream SETTINGS="${settings# }" CODE=$code
  local var
  for var in RUN PID PORT URL RUBY_BIN REPO EVIDENCE PROTECTED_FETCH UPSTREAM SETTINGS CODE; do
    printf '%s=%q\n' "$var" "${!var}"
  done > "$RUN_DIR/instance.env"
  cp "$RUN_DIR/config.yml" "$EVIDENCE/config.yml"

  local i code=""
  for i in $(seq 1 120); do
    alive "$pid" || { tail -n 40 "$RUN_DIR/launch.log" >&2; die "server exited during launch; run cleanup $RUN"; }
    code=$(curl -s -o "$EVIDENCE/launch-health.json" -w '%{http_code}' "$URL/health" || true)
    [ "$code" = 200 ] && break
    sleep 0.5
  done
  [ "$code" = 200 ] || { tail -n 40 "$RUN_DIR/launch.log" >&2; die "/health never returned 200; run cleanup $RUN"; }

  echo "RUN=$RUN"
  echo "URL=$URL"
  echo "PID=$pid"
  echo "RUN_DIR=$RUN_DIR"
  echo "EVIDENCE=$EVIDENCE"
  echo "health: $(cat "$EVIDENCE/launch-health.json")"
}

cmd_doctor() {
  load_run "${1:-}"
  local ok=true pidfile_pid listeners cmdline cwd health version
  check() { if [ "$2" = ok ]; then echo "ok    $1"; else echo "FAIL  $1: $2"; ok=false; fi; }

  if alive "$PID"; then check "process $PID alive" ok; else check "process $PID alive" "not running"; fi
  pidfile_pid=$(cat "$RUN_DIR/base/puma.pid" 2>/dev/null || true)
  [ "$pidfile_pid" = "$PID" ] && check "puma.pid matches launched PID" ok \
    || check "puma.pid matches launched PID" "pidfile has '${pidfile_pid}'"
  cmdline=$(ps -o args= -p "$PID" 2>/dev/null || true)
  server_cmdline "$cmdline" && check "process is this run's gemstash server" ok \
    || check "process is this run's gemstash server" "cmdline '$cmdline'"
  cwd=$(proc_cwd "$PID")
  [ "$cwd" = "$RUN_DIR/work" ] && check "process cwd is this run's work dir" ok \
    || check "process cwd is this run's work dir" "cwd '${cwd}'"
  listeners=$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null || true)
  if printf '%s\n' "$listeners" | grep -qx "$PID"; then check "port $PORT owned by PID $PID" ok
  else check "port $PORT owned by PID $PID" "listeners: ${listeners:-none}"; fi
  health=$(curl -s -w ' %{http_code}' "$URL/health/heartbeat" || true)
  case "$health" in *" 200") check "GET /health/heartbeat" ok ;; *) check "GET /health/heartbeat" "$health" ;; esac
  health=$(curl -s -w ' %{http_code}' "$URL/health/db_read" || true)
  case "$health" in *" 200") check "GET /health/db_read" ok ;; *) check "GET /health/db_read" "$health" ;; esac
  [ "$(code_fingerprint "$RUBY_BIN")" = "${CODE:-}" ] && check "checkout code unchanged since launch" ok \
    || check "checkout code unchanged since launch" "lib, bin, exe, or the bundle changed; this server still runs the old code"
  version=$(user_env gemstash version 2>&1 || true)
  echo "info  $version; checkout $(git -C "$REPO" rev-parse --short HEAD)$(git -C "$REPO" diff --quiet HEAD -- lib bin exe || echo ' (lib/bin/exe modified)')"
  echo "info  url $URL; protected_fetch $PROTECTED_FETCH; upstream $UPSTREAM; evidence $EVIDENCE"
  [ -z "${SETTINGS:-}" ] || echo "info  settings $(printf '%s' "$SETTINGS" | sed -E 's#//[^@/ ]*@#//#g')"
  $ok && echo "doctor: healthy" || { echo "doctor: NOT healthy; run cleanup $RUN and launch again"; return 1; }
}

cmd_run() {
  load_run "${1:-}"
  [ -n "${2:-}" ] && [ -n "${3:-}" ] || die "usage: run RUN LABEL 'SHELL COMMAND'"
  check_label "$2"
  record "$2" "$3"
}

cmd_make_gem() {
  load_run "${1:-}"
  local name="${2:?NAME}" version="${3:?VERSION}" dir
  dir="$RUN_DIR/work/src/$name-$version"
  mkdir -p "$dir/lib"
  # verify-private -> VerifyPrivate, with Ruby rather than GNU-only sed \U.
  echo "module $("$RUBY_BIN/ruby" -e 'print ARGV[0].split(/[-_]/).map { |p| p[0].upcase + p[1..] }.join' "$name"); VERSION = \"$version\"; end" > "$dir/lib/$name.rb"
  cat > "$dir/$name.gemspec" <<EOF
Gem::Specification.new do |s|
  s.name = "$name"
  s.version = "$version"
  s.summary = "verify-gemstash test gem"
  s.authors = ["verify-gemstash"]
  s.license = "MIT"
  s.files = ["lib/$name.rb"]
end
EOF
  record "make-gem-$name-$version" "cd src/$name-$version && gem build $name.gemspec --output ../../$name-$version.gem"
}

cmd_state() {
  load_run "${1:-}"
  local label="${2:-}" seq
  check_label "$label"
  seq=$(next_seq)
  # Read the run's database: read-only SQLite by default, else the configured db_url.
  {
    BUNDLE_GEMFILE="$REPO/Gemfile" "$RUBY_BIN/ruby" -rbundler/setup -rsequel -ryaml -e '
      cfg = YAML.load_file(ARGV[0]) || {}
      if (cfg[:db_adapter] || "sqlite3").to_s == "sqlite3"
        path = File.join(cfg[:base_path], "gemstash.db")
        puts "# database #{path}"
        abort "no database yet (created on first private-gem or authorize use)" unless File.exist?(path)
        db = RUBY_PLATFORM == "java" ? Sequel.connect("jdbc:sqlite:#{path}") : Sequel.sqlite(path, readonly: true)
      else
        puts "# database #{cfg[:db_url].to_s.sub(%r{//[^@/]*@}, "//")}"
        db = Sequel.connect(cfg[:db_url])
      end
      %i[authorizations rubygems versions dependencies upstreams cached_rubygems].each do |t|
        next unless db.table_exists?(t)
        rows = db[t].order(:id).all
        puts "## #{t} (#{rows.size})"
        # One "{key: value, ...}" line per row, the same on every Ruby version.
        rows.each { |r| puts "{" + r.reject { |k, _| %i[created_at updated_at].include?(k) }.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") + "}" }
      end' "$RUN_DIR/config.yml" 2>&1 || true
    echo "# files under base_path"
    (cd "$RUN_DIR/base" && find . -type f ! -name '*.log' | sort)
  } > "$EVIDENCE/$seq-state-$label.txt"
  printf 'state-%s\n' "$label" > "$EVIDENCE/$seq-state-$label.cmd"
  cat "$EVIDENCE/$seq-state-$label.txt"
  echo "[evidence: $EVIDENCE/$seq-state-$label.txt]"
}

cmd_cleanup() {
  load_run "${1:-}"
  local i stopped="server PID $PID was not running"
  command -v lsof > /dev/null || die "cleanup needs lsof to confirm PID $PID is this run's server"
  # Stop or signal PID only while it is still this run's server; a dead
  # server's PID may now belong to an unrelated process.
  if is_our_server "$PID"; then
    # `gemstash stop` signals the pidfile's PID, so use it only when that is ours too.
    if [ "$(cat "$RUN_DIR/base/puma.pid" 2>/dev/null || true)" = "$PID" ]; then
      user_env gemstash stop > "$EVIDENCE/cleanup-stop.txt" 2>&1 || true
    fi
    for i in $(seq 1 40); do is_our_server "$PID" || break; sleep 0.25; done
    if is_our_server "$PID"; then kill -TERM "$PID" 2>/dev/null || true; sleep 2; fi
    is_our_server "$PID" && kill -KILL "$PID" 2>/dev/null || true
    is_our_server "$PID" && die "PID $PID still running; not deleting $RUN_DIR"
    stopped="stopped PID $PID"
  elif alive "$PID"; then
    echo "warning: PID $PID is no longer this run's server (reused?); left it running" >&2
    stopped="left PID $PID alone"
  fi
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t > /dev/null 2>&1; then
    echo "warning: port $PORT still has a listener (not ours to kill)" >&2
  fi
  # Keep the server log with the evidence before removing scratch state.
  cp "$RUN_DIR/base/server.log" "$EVIDENCE/server.log" 2>/dev/null || true
  cp "$RUN_DIR/launch.log" "$EVIDENCE/launch.log" 2>/dev/null || true
  rm -rf "$RUN_DIR"
  echo "$stopped, removed $RUN_DIR"
  echo "evidence kept in $EVIDENCE:"
  ls -1 "$EVIDENCE"
}

cmd_list() {
  [ -d "$RUN_ROOT" ] || { echo "no runs"; return; }
  local d found=false
  for d in "$RUN_ROOT"/*/; do
    [ -f "$d/instance.env" ] || continue
    found=true
    ( . "$d/instance.env"; printf '%s  %s  pid %s %s\n' "$RUN" "$URL" "$PID" "$(kill -0 "$PID" 2>/dev/null && echo alive || echo dead)" )
  done
  $found || echo "no runs"
}

case "${1:-}" in
  launch) shift; cmd_launch "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  run) shift; cmd_run "$@" ;;
  make-gem) shift; cmd_make_gem "$@" ;;
  state) shift; cmd_state "$@" ;;
  cleanup) shift; cmd_cleanup "$@" ;;
  list) shift; cmd_list ;;
  help|-h|--help) usage ;;
  *) echo "verify-gemstash: unknown command '${1:-}'" >&2; usage >&2; exit 2 ;;
esac
